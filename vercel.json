{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "system-map-sigma.vercel.app"
        }
      ],
      "destination": "https://tkrsys-map.vercel.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "system-map-sigma.vercel.app"
        }
      ],
      "destination": "https://tkrsys-map.vercel.app/:path*",
      "permanent": false
    }
  ]
}
